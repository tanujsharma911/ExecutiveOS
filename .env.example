# ── ExecutiveOS local environment ─────────────────────────────
# Postgres (docker compose maps container 5432 → host POSTGRES_PORT)
POSTGRES_USER=executiveos
POSTGRES_PASSWORD=executiveos
POSTGRES_DB=executiveos
POSTGRES_PORT=5433
DATABASE_URL=postgresql://executiveos:executiveos@localhost:5433/executiveos?schema=public

# API
PORT=7461
JWT_SECRET=
CORS_ORIGIN=http://localhost:7462
# Demo mode: lists demo accounts on the sign-in page, and every client (including people who join through the
# intake form) uses the shared demo password SEED_CLIENT_PASSWORD. Set to false for real use: clients then get a
# random password by email and must change it at first sign-in.
SHOW_DEMO_ACCOUNTS=true
# Logging: LOG_LEVEL=debug|info|warn|error · LOG_FORMAT=pretty|json
LOG_LEVEL=info
LOG_FORMAT=pretty

# Seed passwords
SEED_COACH_PASSWORD=Coach@2026
SEED_CLIENT_PASSWORD=Client@2026

# AI (LangChain / LangGraph)
# Analysis always uses an LLM first: Gemini (primary) → Groq (fallback).
# DETERMINISTIC_FALLBACK=true  → if Gemini and Groq both fail (or no key is set), the
#                                 deterministic analyst answers instead.
# DETERMINISTIC_FALLBACK=false → never use the deterministic analyst; AI features
#                                 return "AI unavailable" instead. (default)
DETERMINISTIC_FALLBACK=false
# Google Gemini — primary (key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq — fallback (key from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=executiveos

# Web app (Vite) port and the API target it proxies /api to
WEB_PORT=7462
VITE_API_PROXY=http://localhost:7461

# Bryntum (Session Calendar). Trial license key from bryntum.com. Without it the calendar shows a trial watermark.
# Exposed to the browser (VITE_ prefix), which is how Bryntum license keys are meant to be used.
VITE_BRYNTUM_LICENSE_KEY=

# Email (welcome emails with sign-in details, intake links, call invites) through Resend: https://resend.com (free tier).
# Without RESEND_API_KEY, emails are written to the server log instead of sent.
RESEND_API_KEY=
# Sender. onboarding@resend.dev only delivers to your own Resend account email; verify a domain to email real clients.
EMAIL_FROM=ExecutiveOS <onboarding@resend.dev>
# Public URL of the web app, used for links in emails (intake form, sign-in)
APP_URL=http://localhost:7462

# PayPal (intake form payments). Sandbox app keys from developer.paypal.com → Apps & Credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: webhook ID for PAYMENT.CAPTURE.COMPLETED → POST {API}/api/public/paypal/webhook (backup if the browser closes)
PAYPAL_WEBHOOK_ID=
# Auto-renewing programs: how often (minutes) to check PayPal for renewals and failed payments. Webhooks do this
# instantly when PayPal can reach the API (hosted / tunnel); this sync covers local development. 0 turns it off.
SUBSCRIPTION_SYNC_MINUTES=60

# AG Grid Enterprise (row grouping, Excel export, expandable detail rows). Without a key the grids still work
# but show a trial watermark and console warnings. Ask AG Grid (hackathon sponsor) for a trial key.
VITE_AG_GRID_LICENSE_KEY=

# ── Docker Free Tunneling (Cloudflare Tunnel) ───────────────
# Get your token from Cloudflare Zero Trust (https://one.dash.cloudflare.com → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
